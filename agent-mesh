#!/usr/bin/env bash
# agent-mesh — Agent-Mesh CLI: verbindet mehrere Hermes-Agents zu einem Wissens-Verbund.
#
# Repos:
#   PUBLIC   <GH_ORG>/agent-mesh          — dieses Framework
#   PRIVATE  <GH_ORG>/agent-mesh-memories — Memories, Skills, Vault (nie public!)
#
# Konzept:
#   Jeder Rechner hat EINEN Agent (Namen aus agent-mesh.conf). Der Agent exportiert
#   sein Hermes-Wissen (MEMORY.md, USER.md, skills/, insights/) in das private
#   Repo, pullt das Wissen der anderen Agents und teilt Secrets über das
#   sops+age-Verschlüsselte Vault. Kein Secret liegt jemals im Klartext im Repo.
#
# Usage:
#   mesh init <agent-name>          Erste Einrichtung (age-Key + Konfig)
#   mesh sync                       Pull → Wissen exportieren/importieren → Push
#   mesh vault set <key> <value>    Secret verschlüsselt ablegen
#   mesh vault get <key>            Secret entschlüsselt ausgeben
#   mesh vault list                 Alle Schlüssel auflisten (ohne Werte)
#   mesh vault add-key <agent>      Agent-Key zum Vault hinzufügen
#   mesh insight add <text>         Erkenntnis teilen (Markdown-Datei)
#   mesh status                     Zusammenfassung

set -euo pipefail

AGENT_MESH_HOME="${AGENT_MESH_HOME:-$HOME/.agent-mesh}"
CONF="$AGENT_MESH_HOME/agent-mesh.conf"

# Rangfolge der Konfiguration: Umgebungsvariable > agent-mesh.conf > Default.
# (Idee aus PR #8 von @HearthCore — bis dahin waren Repo-Namen und Python-Pfad
#  nur über Umgebungsvariablen setzbar, also in jeder Shell neu zu exportieren.)
# Was per env kam, wird HIER festgehalten, weil die Defaults gleich darunter
# greifen und load_conf sonst "gesetzt" und "Default" nicht mehr unterscheiden
# könnte.
_ENV_GH_ORG="${AGENT_MESH_GH_ORG:-}"
_ENV_PUBLIC_REPO="${AGENT_MESH_PUBLIC_REPO:-}"
_ENV_PRIVATE_REPO="${AGENT_MESH_PRIVATE_REPO:-}"
_ENV_PYTHON_BIN="${PYTHON_BIN:-}"

GH_ORG="${AGENT_MESH_GH_ORG:-moinsen-dev}"
# Eigene-Mesh-Vision (User, 2026-08-22): JEDER GitHub-User hat sein EIGENES
# privates Mesh-Repo. GH_OWNER = wem die Repos gehören (User oder Org).
GH_OWNER="${AGENT_MESH_GH_OWNER:-}"
if [ -z "$GH_OWNER" ]; then
  GH_OWNER=$(gh api user --jq .login 2>/dev/null | head -1 || true)
fi
[ -z "$GH_OWNER" ] && GH_OWNER="$GH_ORG"
PUBLIC_REPO="${AGENT_MESH_PUBLIC_REPO:-agent-mesh}"
PRIVATE_REPO="${AGENT_MESH_PRIVATE_REPO:-agent-mesh-memories}"
MEMORIES_DIR="$AGENT_MESH_HOME/memories"          # Klon des privaten Repos
FRAMEWORK_DIR="$AGENT_MESH_HOME/framework"        # Klon des public Repos

# CLI-Gerüst (Registry, Hilfe, Version) — muss ZUERST kommen: es ist das
# Einzige, was auch ohne Konfiguration funktionieren muss.
CLI_MODULE="$(dirname "$(readlink -f "$0")")/agent-mesh-cli.sh"
[ -f "$CLI_MODULE" ] && source "$CLI_MODULE"
# Kommt das Modul einmal nicht mit — ein Update, das nur die Hälfte
# installiert, ist in diesem Projekt keine Theorie —, dann darf NICHT die
# ganze Kommandozeile ausfallen. Der Dispatcher ruft cli_is_command bei jedem
# Aufruf; eine fehlende Funktion würde unter `set -e` jedes einzelne Kommando
# beenden, statt nur die Hilfe zu kosten.
if ! type cli_is_command >/dev/null 2>&1; then
  AGENT_MESH_VERSION="unbekannt"
  cli_is_command() { return 1; }
  cli_overview() { echo "⚠️  agent-mesh-cli.sh fehlt neben $0 — keine Hilfe verfügbar." >&2
                   echo "   Installation reparieren: agent-mesh update --force" >&2; }
  cli_cmd_help() { cli_overview; }
  cli_version()  { echo "agent-mesh (Version unbekannt — agent-mesh-cli.sh fehlt)"; }
  cli_unknown()  { echo "❌ Unbekanntes Kommando: '${1:-}'" >&2; }
fi
# Memory-Modul (gemeinsames Gedächtnis über einen Hermes-Memory-Provider)
MEMORY_MODULE="$(dirname "$(readlink -f "$0")")/agent-mesh-memory.sh"
[ -f "$MEMORY_MODULE" ] && source "$MEMORY_MODULE"
# A2A-Modul (Agent-to-Agent, Rollen, Hub-Routing) einbinden
A2A_MODULE="$(dirname "$(readlink -f "$0")")/agent-mesh-a2a.sh"
[ -f "$A2A_MODULE" ] && source "$A2A_MODULE"
# Update-Modul einbinden (mesh update / --check / --hermes)
UPDATE_MODULE="$(dirname "$(readlink -f "$0")")/agent-mesh-update.sh"
[ -f "$UPDATE_MODULE" ] && source "$UPDATE_MODULE"
# Watch-Modul (Polling-Daemon) — nur für `watch`-Dispatch
WATCH_MODULE="$(dirname "$(readlink -f "$0")")/agent-mesh-watch.sh"
[ -f "$WATCH_MODULE" ] && source "$WATCH_MODULE"
# Connect-Modul (User-Autorisierung: GitHub-Account verknüpfen)
CONNECT_MODULE="$(dirname "$(readlink -f "$0")")/agent-mesh-connect.sh"
[ -f "$CONNECT_MODULE" ] && source "$CONNECT_MODULE"
# Doctor-Modul (Preflight-Checks: Vault, Netz, Abhängigkeiten)
DOCTOR_MODULE="$(dirname "$(readlink -f "$0")")/agent-mesh-doctor.sh"
[ -f "$DOCTOR_MODULE" ] && source "$DOCTOR_MODULE"
# Responder-Modul (Auto-Antworten auf eingehende Nachrichten)
RESPONDER_MODULE="$(dirname "$(readlink -f "$0")")/agent-mesh-responder.sh"
[ -f "$RESPONDER_MODULE" ] && source "$RESPONDER_MODULE"
# Service-Modul (watch als Hintergrund-Dienst: systemd/launchd/Task-Scheduler)
SERVICE_MODULE="$(dirname "$(readlink -f "$0")")/agent-mesh-service.sh"
[ -f "$SERVICE_MODULE" ] && source "$SERVICE_MODULE"
# Governance-Modul (Selbst-Verwaltung: Issues verteilen)
GOVERN_MODULE="$(dirname "$(readlink -f "$0")")/agent-mesh-govern.sh"
[ -f "$GOVERN_MODULE" ] && source "$GOVERN_MODULE"
# Autofix-Modul (Selbst-Verbesserung: Issues fixen + PR)
AUTOFIX_MODULE="$(dirname "$(readlink -f "$0")")/agent-mesh-autofix.sh"
[ -f "$AUTOFIX_MODULE" ] && source "$AUTOFIX_MODULE"

die() { echo "❌ $*" >&2; exit 1; }
info() { echo "ℹ️  $*"; }
warn() { echo "⚠️  $*" >&2; }
# macOS liefert bash 3.2 — ${var,,} ist bash-4-Syntax und bricht dort hart ab.
lower_of() { printf '%s' "$1" | tr '[:upper:]' '[:lower:]'; }

# ── Windows/macOS/Git-Bash-Kompatibilitäts-Layer (Issues #1,#2 + macmini-Fund) ──
# Python: python3 auf POSIX/macOS, python auf Windows (kein python3-Alias)
# WICHTIG (macmini 2026-08-22): macOS hat NUR python3, kein python!
PYTHON_BIN="${PYTHON_BIN:-}"
if [ -z "$PYTHON_BIN" ]; then
  # python3 → python → py: der py-Launcher ist auf Windows oft das Einzige,
  # was im PATH steht (PR #8, @HearthCore).
  for _cand in python3 python py; do
    if command -v "$_cand" >/dev/null 2>&1; then PYTHON_BIN="$_cand"; break; fi
  done
  [ -n "$PYTHON_BIN" ] || die "Python fehlt — bitte installieren (https://www.python.org)"
fi

# age/age-keygen: .exe-Suffix auf Windows auflösen
AGE_BIN="${AGE_BIN:-}"
if [ -z "$AGE_BIN" ]; then
  if command -v age >/dev/null 2>&1; then AGE_BIN=age
  elif command -v age.exe >/dev/null 2>&1; then AGE_BIN=age.exe
  else AGE_BIN=age; fi  # wird beim Nutzen geprüft
fi
AGE_KEYGEN_BIN="${AGE_KEYGEN_BIN:-}"
if [ -z "$AGE_KEYGEN_BIN" ]; then
  if command -v age-keygen >/dev/null 2>&1; then AGE_KEYGEN_BIN=age-keygen
  elif command -v age-keygen.exe >/dev/null 2>&1; then AGE_KEYGEN_BIN=age-keygen.exe
  else AGE_KEYGEN_BIN=age-keygen; fi
fi

# MSYS-Pfad → Windows-Pfad konvertieren (für native .exe-Argumente)
winpath() {
  case "$(uname -s 2>/dev/null)" in
    MINGW*|MSYS*|CYGWIN*) cygpath -w "$1" 2>/dev/null || echo "$1" ;;
    *) echo "$1" ;;
  esac
}

# ─────────────────────────── Konfiguration ───────────────────────────
load_conf() {
  [ -f "$CONF" ] || die "Nicht initialisiert — zuerst: mesh init <agent-name>"
  AGENT_NAME=$(grep "^AGENT_NAME=" "$CONF" | cut -d= -f2- || true)
  AGE_PUB=$(grep "^AGE_PUB=" "$CONF" | cut -d= -f2- || true)
  AGE_KEY_FILE="$AGENT_MESH_HOME/keys/$AGENT_NAME.age"
  # Eigene-Mesh-Vision: Owner aus conf (falls dort gespeichert)
  OWNER_LINE=$(grep "^AGENT_MESH_GH_OWNER=" "$CONF" | cut -d= -f2- || true)
  [ -n "$OWNER_LINE" ] && GH_OWNER="$OWNER_LINE"

  # Repo- und Interpreter-Konfiguration aus der conf — nur dort, wo keine
  # Umgebungsvariable gesetzt war. Feste Schlüsselliste statt die Datei zu
  # sourcen: eine conf soll Werte setzen können, keine Befehle ausführen.
  local _v
  _v=$(grep "^GH_ORG=" "$CONF" | cut -d= -f2- | head -1 || true)
  [ -z "$_ENV_GH_ORG" ] && [ -n "$_v" ] && GH_ORG="$_v"
  _v=$(grep "^PUBLIC_REPO=" "$CONF" | cut -d= -f2- | head -1 || true)
  [ -z "$_ENV_PUBLIC_REPO" ] && [ -n "$_v" ] && PUBLIC_REPO="$_v"
  _v=$(grep "^PRIVATE_REPO=" "$CONF" | cut -d= -f2- | head -1 || true)
  [ -z "$_ENV_PRIVATE_REPO" ] && [ -n "$_v" ] && PRIVATE_REPO="$_v"
  _v=$(grep "^PYTHON_BIN=" "$CONF" | cut -d= -f2- | head -1 || true)
  [ -z "$_ENV_PYTHON_BIN" ] && [ -n "$_v" ] && command -v "$_v" >/dev/null 2>&1 && PYTHON_BIN="$_v"
  # GH_OWNER folgt GH_ORG, wenn er nicht ausdrücklich gesetzt wurde
  [ -z "${AGENT_MESH_GH_OWNER:-}" ] && [ -z "$OWNER_LINE" ] && GH_OWNER="$GH_ORG"
  # Optional: SSH-Key für Git-Operationen (wenn Agent als anderer User läuft)
  SSH_LINE=$(grep "^GIT_SSH_COMMAND=" "$CONF" | cut -d= -f2- || true)
  if [ -n "$SSH_LINE" ]; then
    export GIT_SSH_COMMAND="$SSH_LINE"
  fi
}

# ─────────────────────────── init ───────────────────────────
# Git-Protokoll ableiten: HTTPS wenn gh eingeloggt (OAuth), sonst SSH (opt-in)
git_clone_url() {
  # $1 = Repo-Name (z.B. agent-mesh-memories) — Owner = GH_OWNER (privates Mesh)
  if gh auth status >/dev/null 2>&1; then
    echo "https://github.com/$GH_OWNER/$1.git"
  else
    echo "git@github.com:$GH_OWNER/$1.git"
  fi
}

cmd_init() {
  [ $# -ge 1 ] || die "Usage: agent-mesh init <agent-name>"
  local name="$1"
  [ -f "$CONF" ] && die "Bereits initialisiert ($(grep AGENT_NAME= "$CONF")). Für Neustart: rm -rf $AGENT_MESH_HOME"
  # Issue #1: NUR keys/ vorab anlegen — Klon-Ziele NICHT (git clone braucht leere/nicht existente Ziele)
  mkdir -p "$AGENT_MESH_HOME/keys"

  # age-Keypaar für diesen Agent (Windows: .exe + Pfad-Konvertierung)
  command -v "$AGE_KEYGEN_BIN" >/dev/null 2>&1 || die "age-keygen fehlt — bitte installieren (https://github.com/FiloSottile/age/releases)"
  "$AGE_KEYGEN_BIN" -o "$(winpath "$AGENT_MESH_HOME/keys/$name.age")" 2>/dev/null \
    || "$AGE_KEYGEN_BIN" -o "$AGENT_MESH_HOME/keys/$name.age" 2>/dev/null \
    || die "age-keygen fehlgeschlagen (Ausgabe-Pfad prüfen)"
  local pub
  pub=$("$AGE_KEYGEN_BIN" -y "$AGENT_MESH_HOME/keys/$name.age" 2>/dev/null || true)
  [ -n "$pub" ] || die "age-Key konnte nicht gelesen werden"
  chmod 600 "$AGENT_MESH_HOME/keys/$name.age" 2>/dev/null || true

  # Repo-Konfiguration mit ablegen, wenn sie vom Default abweicht — sonst
  # müsste sie in jeder Shell neu exportiert werden (PR #8, @HearthCore).
  {
    echo "# Agent-Mesh Konfiguration (lokal, nie committen)"
    echo "AGENT_NAME=$name"
    echo "AGE_PUB=$pub"
    [ "$GH_ORG" != "moinsen-dev" ] && echo "GH_ORG=$GH_ORG"
    [ "$PUBLIC_REPO" != "agent-mesh" ] && echo "PUBLIC_REPO=$PUBLIC_REPO"
    [ "$PRIVATE_REPO" != "agent-mesh-memories" ] && echo "PRIVATE_REPO=$PRIVATE_REPO"
    [ -n "$_ENV_PYTHON_BIN" ] && echo "PYTHON_BIN=$PYTHON_BIN"
    [ -n "${AGENT_MESH_GH_OWNER:-}" ] && echo "AGENT_MESH_GH_OWNER=$GH_OWNER"
    true
  } > "$CONF"
  chmod 600 "$CONF"

  # Repos klonen — Protokoll aus gh ableiten (Issue #1: OAuth/HTTPS-konsistent!)
  info "Klonen: $GH_OWNER/$PRIVATE_REPO …"
  if ! git clone "$(git_clone_url "$PRIVATE_REPO")" "$MEMORIES_DIR" 2>/dev/null; then
    # Ziel existiert evtl. (vom alten Verhalten) — nur klonen wenn es kein Git-Repo ist
    if [ -d "$MEMORIES_DIR/.git" ]; then
      info "Klon existiert bereits (Git-Repo) — überspringe."
    else
      rm -rf "$MEMORIES_DIR" 2>/dev/null || true
      die "❌ Konnte privates Repo NICHT klonen — prüfe Zugriff auf $GH_OWNER/$PRIVATE_REPO"
    fi
  fi
  info "Klonen: $GH_ORG/$PUBLIC_REPO …"
  if ! git clone "$(git_clone_url "$PUBLIC_REPO")" "$FRAMEWORK_DIR" 2>/dev/null; then
    if [ ! -d "$FRAMEWORK_DIR/.git" ]; then
      # Public-Repo ist optional (Framework kann auch via install.sh kommen) — aber warnen
      warn "Public-Repo nicht geklont (optional — Framework-Dateien kommen ggf. vom Installer)"
    fi
  fi

  # Agent-Ordner anlegen
  mkdir -p "$MEMORIES_DIR/agents/$name/skills" "$MEMORIES_DIR/agents/$name/insights" \
           "$MEMORIES_DIR/vault/keys"

  # Public-Key im privaten Repo ablegen (für Vault-Verschlüsselung durch andere)
  echo "$pub" > "$MEMORIES_DIR/vault/keys/$name.age.pub"
  # Signaturschlüssel (Befund 10): Echtheit von Nachrichten, nicht nur Vertraulichkeit
  AGENT_NAME="$name" ensure_sign_key
  cp "$AGENT_MESH_HOME/keys/$name.ssh.pub" "$MEMORIES_DIR/vault/keys/$name.ssh.pub"
  info "✅ Agent '$name' initialisiert (age-Key: $AGENT_MESH_HOME/keys/$name.age)"
  info "   Public-Key registriert: vault/keys/$name.age.pub"
  info "   Nächster Schritt: agent-mesh sync (pusht die Registrierung)"
}

# ─────────────────────────── sync ───────────────────────────
cmd_sync() {
  load_conf
  cd "$MEMORIES_DIR"
  info "Pull von $GH_OWNER/$PRIVATE_REPO …"
  git pull --rebase origin main 2>/dev/null || git pull --rebase origin master 2>/dev/null \
    || info "Pull übersprungen (Repo evtl. noch leer/ohne Branch)"

  local agent_dir="agents/$AGENT_NAME"
  mkdir -p "$agent_dir/skills" "$agent_dir/insights" vault/keys

  # Public-Keys (immer aktuell) — Verschlüsselung UND Signatur
  echo "$AGE_PUB" > "vault/keys/$AGENT_NAME.age.pub"
  ensure_sign_key
  cp "$(sign_key_file).pub" "vault/keys/$AGENT_NAME.ssh.pub"

  # Hermes-Wissen exportieren (falls Hermes vorhanden)
  if command -v hermes >/dev/null 2>&1; then
    info "Hermes-Wissen exportieren …"
    mkdir -p "$agent_dir"
    # Memories (MEMORY.md/USER.md liegen im Hermes-Home)
    for f in MEMORY.md USER.md; do
      src="$HOME/.hermes/memories/$f"
      [ -f "$src" ] && cp "$src" "$agent_dir/$f" && info "  ✓ $f"
    done
    # Skills (nur agent-erstellte — Provenienz steht in .usage.json, nicht im Frontmatter!)
    if [ -d "$HOME/.hermes/skills" ]; then
      mkdir -p "$agent_dir/skills"
      # agent-erstellte Skills aus .usage.json ermitteln (created_by: agent)
      if [ -f "$HOME/.hermes/skills/.usage.json" ]; then
        "$PYTHON_BIN" - "$HOME/.hermes/skills/.usage.json" "$agent_dir/skills" "$HOME/.hermes/skills" << 'PYEOF'
import json, os, sys, shutil
usage_path, dest, src_root = sys.argv[1], sys.argv[2], sys.argv[3]
try:
    usage = json.load(open(usage_path))
except Exception:
    usage = {}
agent_skills = {name for name, meta in usage.items() if meta.get("created_by") == "agent"}
for name in sorted(agent_skills):
    # Skill-Verzeichnis finden (Kategorie-Unterordner)
    for dirpath, dirnames, filenames in os.walk(src_root):
        if "SKILL.md" in filenames and os.path.basename(dirpath) == name:
            rel = os.path.relpath(dirpath, src_root)
            target = os.path.join(dest, rel)
            shutil.copytree(dirpath, target, dirs_exist_ok=True)
            print(f"  ✓ Skill: {rel}")
            break
PYEOF
      fi
    fi
  else
    info "Hermes nicht gefunden — nur Git-Sync."
  fi

  # ── Zustandsbericht mitveröffentlichen (Flotten-Übersicht) ──
  # Git ist ohnehin die Datenebene: kein neuer Port, kein Dienst, funktioniert
  # auch für Agents, die gerade offline sind, und die Historie fällt gratis ab.
  # Best effort — ein Fehler hier darf einen sync niemals scheitern lassen.
  # Erst in eine Temp-Datei, dann PRÜFEN, dann übernehmen. Ein halb
  # geschriebener oder mit Fremdausgabe verunreinigter Bericht ist schlimmer
  # als gar keiner: er sieht in der Flotten-Übersicht wie ein defekter Agent
  # aus, obwohl nur das Schreiben schiefging.
  #
  # Und er wird nur übernommen, wenn er etwas NEUES sagt. Bis v1.27.0 änderte
  # sich bei jedem sync mindestens der Zeitstempel — also gab es immer einen
  # Commit, also sahen alle anderen Agents "Repo geändert", also synchten sie,
  # also committeten sie ihrerseits. Sechs Agents im Minutentakt haben sich so
  # gegenseitig dauerhaft in Bewegung gehalten, ohne dass je etwas passiert
  # wäre. Ein Herzschlag darf nicht der Grund für den nächsten sein.
  publish_report || true

  # Einmalige Räumung: der eigene Bericht lag bis v1.33.0 auf main und
  # verstopft dort die Historie. Nur der EIGENE — was andere Agenten dort
  # liegen haben, räumen sie selbst weg, wenn sie nachziehen.
  if [ -f "$agent_dir/report.json" ]; then
    git rm -q --cached "$agent_dir/report.json" 2>/dev/null || true
    rm -f "$agent_dir/report.json"
    info "Bericht von main entfernt — er lebt jetzt unter reports/$AGENT_NAME"
  fi

  # Commit + Push
  git add -A 2>/dev/null
  if ! git diff --cached --quiet 2>/dev/null; then
    git commit -m "mesh-sync: $AGENT_NAME — $(date -u +%Y-%m-%dT%H:%M:%SZ)" 2>/dev/null \
      || info "Nichts zu committen"
    push_retry
  else
    info "Keine Änderungen — nichts zu committen"
  fi

  info "✅ Sync abgeschlossen."
  cmd_status
}

# ── Berichte gehören nicht in die Historie des Wissens ────────────────────
#
# Gemessen am 2026-08-24: 11.478 von 12.159 Dateiänderungen im privaten Repo
# waren report.json — 94,4 %. Ein Commit auf main hiess damit fast nie "es gibt
# etwas Neues zu wissen", und genau darauf hört jeder Agent bei jedem Durchlauf.
# Herzschlag und Wissen teilten sich einen Kanal, und der Herzschlag hat ihn
# übertönt.
#
# Jeder Agent schreibt seinen Bericht jetzt auf eine EIGENE Referenz:
#
#     refs/heads/reports/<agent>      ein einziger elternloser Commit,
#                                     force-gepusht, Historie wächst nie
#
# Drei Dinge folgen daraus, und das dritte ist das eigentliche:
#   1. main ändert sich nur noch, wenn es wirklich etwas Neues gibt.
#   2. Zwei Agenten kommen sich nie in die Quere — jeder schreibt nur seine
#      eigene Referenz, also gibt es weder Rebase noch Wettlauf.
#   3. Die Kaskade ist nicht mehr durch eine Regel verhindert, sondern durch
#      die Konstruktion: ein Bericht kann keinen sync bei jemand anderem mehr
#      auslösen, weil er main nicht berührt.
#
# Geschrieben wird ohne Arbeitsverzeichnis, direkt über git-Plumbing — einen
# zweiten Branch auszuchecken wäre teuer und würde den laufenden sync stören.
REPORT_REF_PREFIX="refs/heads/reports"

publish_report() {   # publish_report [--force]
  local force="${1:-}"
  local tmp; tmp=$(mktemp)
  if ! cmd_report --json > "$tmp" 2>/dev/null \
     || [ ! -s "$tmp" ] \
     || ! "$PYTHON_BIN" -c "import json,sys; json.load(open(sys.argv[1]))" "$tmp" 2>/dev/null; then
    rm -f "$tmp"
    warn "Zustandsbericht ungültig — nicht veröffentlicht."
    warn "  Selbst ansehen: agent-mesh report --json | head -5"
    return 1
  fi

  # Sagt der Bericht etwas Neues? Verglichen wird gegen die zuletzt
  # VERÖFFENTLICHTE Fassung, die lokal liegt — dafür muss nichts geholt werden.
  local cache="$AGENT_MESH_HOME/.last-report.json"
  if [ "$force" != "--force" ] && ! report_is_news "$tmp" "$cache"; then
    rm -f "$tmp"; return 0
  fi

  local blob tree commit rc=0
  blob=$(cd "$MEMORIES_DIR" && git hash-object -w "$tmp" 2>/dev/null) || rc=1
  if [ "$rc" = "0" ] && [ -n "$blob" ]; then
    tree=$(cd "$MEMORIES_DIR" && printf '100644 blob %s\treport.json\n' "$blob" | git mktree 2>/dev/null) || rc=1
  fi
  if [ "$rc" = "0" ] && [ -n "${tree:-}" ]; then
    # Kein -p: ein elternloser Commit. Die alte Fassung wird ersetzt, nicht
    # fortgeschrieben — die Historie eines Herzschlags interessiert niemanden.
    commit=$(cd "$MEMORIES_DIR" && git commit-tree "$tree" \
             -m "report: $AGENT_NAME $(date -u +%Y-%m-%dT%H:%M:%SZ)" 2>/dev/null) || rc=1
  fi
  if [ "$rc" != "0" ] || [ -z "${commit:-}" ]; then
    rm -f "$tmp"; warn "Bericht konnte nicht geschrieben werden (git-Plumbing)."; return 1
  fi

  if (cd "$MEMORIES_DIR" && git push --force --quiet origin \
      "$commit:$REPORT_REF_PREFIX/$AGENT_NAME" 2>/dev/null); then
    mv -f "$tmp" "$cache"
    return 0
  fi
  rm -f "$tmp"
  warn "Bericht nicht veröffentlicht (push fehlgeschlagen) — der Verbund sieht den alten Stand."
  return 1
}

# Sagt der neue Bericht etwas, das der alte nicht schon sagt? Der Zeitstempel
# zählt dabei NICHT als Aussage — sonst wäre jeder Bericht eine Neuigkeit und
# die Flotte hielte sich selbst in Bewegung (siehe oben).
#
# Seit v1.34.0 verhindert das keine Kaskade mehr — die ist konstruktiv
# ausgeschlossen, weil ein Bericht main nicht mehr berührt. Es spart nur noch
# Anfragen: ein Bericht, der nichts Neues sagt, muss nicht gepusht werden.
#
# Ausnahme: nach AGENT_MESH_HEARTBEAT Sekunden (Default 1h) wird auch ein
# unveränderter Bericht erneuert. Ohne dieses Lebenszeichen wäre "seit Stunden
# still" nicht mehr von "läuft nicht mehr" zu unterscheiden — und genau diese
# Unterscheidung ist es, die den Rollout vom 2026-08-22 gekostet hat.
report_is_news() {
  local new="$1" old="$2"
  [ -f "$old" ] || return 0
  local hb="${AGENT_MESH_HEARTBEAT:-3600}"
  "$PYTHON_BIN" - "$new" "$old" "$hb" << 'PYNEWS'
import calendar, json, sys, time

new_p, old_p, hb = sys.argv[1], sys.argv[2], int(sys.argv[3])
try:
    new = json.load(open(new_p, encoding="utf-8"))
    old = json.load(open(old_p, encoding="utf-8"))
except Exception:
    sys.exit(0)          # alter Bericht unlesbar → der neue ist auf jeden Fall besser

def without_ts(d):
    return {k: v for k, v in d.items() if k != "ts"}

if without_ts(new) != without_ts(old):
    sys.exit(0)          # inhaltliche Änderung → veröffentlichen

try:
    t = calendar.timegm(time.strptime(old.get("ts", ""), "%Y-%m-%dT%H:%M:%SZ"))
except Exception:
    sys.exit(0)          # ohne lesbaren Zeitstempel lieber erneuern

sys.exit(0 if time.time() - t > hb else 1)
PYNEWS
}

# ─────────────────────────── vault (sops + age) ───────────────────────────
# Security v1.1 (2026-08-22): JEDES Secret ist eine eigene sops-Datei mit
# SELEKTIVEN Empfängern (Least Privilege). Kein Broadcast mehr!
#   vault/secrets/<key>.yaml   — nur die in --for genannten Agents lesen
#   vault/keys/<agent>.age.pub — Public-Keys (Empfänger-Registry)

vault_dir() { echo "$MEMORIES_DIR/vault/secrets"; }
vault_file() { echo "$(vault_dir)/$1.yaml"; }

# ── Key-Pinning (Security v1.2, Audit-Befund #6) ──
# Die Empfänger-Registry ist nur ein Verzeichnis im privaten Repo: ohne
# Signatur, ohne Herkunftsnachweis. Wer pushen darf, kann fremde .pub-Dateien
# überschreiben und bekommt ab dem nächsten sync alle Nachrichten und Secrets,
# die an diesen Agent gehen. Dagegen hilft TOFU: Beim ERSTEN Kontakt merken wir
# uns den Key lokal in agent-mesh.conf (PIN_<agent>=<key>), danach ist jede
# Abweichung ein harter Abbruch — kein stilles Weiterverschlüsseln.
pin_get()    { grep "^PIN_$1=" "$CONF" 2>/dev/null | cut -d= -f2- | head -1; }
pin_forget() {
  [ -f "$CONF" ] || return 0
  local tmp; tmp=$(mktemp)
  grep -v "^PIN_$1=" "$CONF" > "$tmp" 2>/dev/null || true
  cat "$tmp" > "$CONF" && rm -f "$tmp"
}
pin_set() {
  pin_forget "$1"
  printf 'PIN_%s=%s\n' "$1" "$2" >> "$CONF"
}

# Public-Key eines Agents lesen (aus der Registry, gegen den Pin geprüft).
# ACHTUNG: stdout ist der Key — alle Meldungen müssen nach stderr!
agent_pub() {
  local a="$1"
  local f="$MEMORIES_DIR/vault/keys/$a.age.pub"
  [ -f "$f" ] || die "Kein Public-Key für Agent '$a' registriert (vault/keys/$a.age.pub fehlt — Agent muss erst sync'en)"
  local pub; pub=$(cat "$f")
  [ -n "$pub" ] || die "Public-Key für '$a' ist leer (vault/keys/$a.age.pub)"

  local pinned; pinned=$(pin_get "$a")
  if [ -z "$pinned" ]; then
    pin_set "$a" "$pub"
    echo "🔑 Key von '$a' erstmalig gepinnt (TOFU): ${pub:0:20}…" >&2
  elif [ "$pinned" != "$pub" ]; then
    die "🚨 KEY-WECHSEL bei Agent '$a' — Verschlüsselung abgebrochen!

    Gepinnt (bekannt):  $pinned
    In der Registry:    $pub

  Entweder hat '$a' seinen Key legitim erneuert — oder jemand mit Push-Recht
  hat die Registry manipuliert, um eure Nachrichten und Secrets mitzulesen.

  → NICHT einfach bestätigen. Erst über einen ZWEITEN Kanal (Anruf, Signal,
    direkte SSH-Sitzung) prüfen, ob der neue Key wirklich von '$a' stammt.
  → Danach übernehmen mit:  agent-mesh vault repin $a"
  fi
  echo "$pub"
}

# Empfänger EINES bestehenden Secrets auslesen (aus dem sops-Metadatenblock).
# Security v1.2 (Audit-Befund #5): revoke muss die ursprüngliche Empfänger-
# liste jedes Secrets kennen — sonst wird beim Re-Encrypt aus Least Privilege
# unbemerkt ein Broadcast an alle registrierten Keys.
secret_recipients() {
  # $1 = Pfad zur .yaml — echo: eine bech32-Adresse pro Zeile
  grep -oE 'recipient: age1[0-9a-z]+' "$1" 2>/dev/null | awk '{print $2}' | sort -u
}

# Empfänger-Liste bauen: --for agent1,agent2 → kommagetrennte bech32-Keys
recipients_for() {
  # $1 = kommagetrennte Agent-Namen; Leer = nur der eigene Key
  local agents="${1:-$AGENT_NAME}"
  local keys=() name
  IFS=',' read -ra names <<< "$agents"
  for name in "${names[@]}"; do
    name=$(echo "$name" | xargs)  # trim
    [ -n "$name" ] || continue
    local k
    # WICHTIG: agent_pub kann per die() abbrechen — in einer Kommando-
    # Substitution beendet das nur die Subshell. Deshalb Status prüfen und
    # den Abbruch selbst weiterreichen (sonst liefe der Aufrufer mit einer
    # unvollständigen oder leeren Empfängerliste weiter).
    k=$(agent_pub "$name") || return 1
    [ -n "$k" ] || return 1
    keys+=("$k")
  done
  [ ${#keys[@]} -gt 0 ] || die "Keine gültigen Empfänger angegeben"
  printf '%s,' "${keys[@]}" | sed 's/,$//'
}

cmd_vault_set() {
  load_conf
  # Syntax: vault set <key> <value> [--for agent1,agent2]
  local key="" value="" for_agents=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --for) for_agents="$2"; shift 2 ;;
      *) if [ -z "$key" ]; then key="$1"; else value="${value:+$value }$1"; fi; shift ;;
    esac
  done
  [ -n "$key" ] && [ -n "$value" ] || die "Usage: agent-mesh vault set <key> <value> [--for agent1,agent2]"
  mkdir -p "$(vault_dir)"
  local vf; vf=$(vault_file "$key")

  # Wert als JSON ablegen
  local tmp; tmp=$(mktemp)
  "$PYTHON_BIN" - "$tmp" "$key" "$value" << 'EOF'
import json, sys
path, key, value = sys.argv[1], sys.argv[2], sys.argv[3]
with open(path, "w") as f: json.dump({key: value}, f, indent=2)
EOF

  # Empfänger ZUERST bestimmen und prüfen — erst danach verschlüsseln.
  # (Früher stand recipients_for inline im sops-Aufruf. Ein die() darin läuft
  #  in einer Subshell und beendet das Skript NICHT: bei abgelehntem Key-Pin
  #  wurde das Secret trotzdem geschrieben — mit leerer Empfängerliste.)
  local recipients
  if ! recipients=$(recipients_for "$for_agents"); then
    rm -f "$tmp"
    die "Empfänger konnten nicht bestimmt werden — Secret NICHT geschrieben."
  fi
  if [ -z "$recipients" ]; then
    rm -f "$tmp"
    die "Leere Empfängerliste — Secret NICHT geschrieben."
  fi

  # Mit NUR den angegebenen Empfängern verschlüsseln (Least Privilege!)
  if ! SOPS_AGE_KEY_FILE="$AGE_KEY_FILE" sops --encrypt \
    --age "$recipients" \
    --input-type json --output-type yaml \
    "$tmp" > "$vf" 2>/dev/null; then
    rm -f "$tmp" "$vf"
    die "Verschlüsselung fehlgeschlagen"
  fi
  rm -f "$tmp"

  cd "$MEMORIES_DIR" && git add "vault/secrets/$key.yaml" vault/keys/ 2>/dev/null
  git commit -m "vault: $key (via $AGENT_NAME, für: ${for_agents:-nur $AGENT_NAME})" 2>/dev/null || true
  push_retry
  info "✅ Secret '$key' verschlüsselt (Empfänger: ${for_agents:-nur $AGENT_NAME})"
}

cmd_vault_get() {
  load_conf
  [ $# -ge 1 ] || die "Usage: agent-mesh vault get <key>"
  local vf; vf=$(vault_file "$1")
  [ -f "$vf" ] || die "Secret '$1' existiert nicht"
  local tmp; tmp=$(mktemp)
  SOPS_AGE_KEY_FILE="$AGE_KEY_FILE" sops -d --output-type json "$vf" > "$tmp" 2>/dev/null \
    || die "Entschlüsselung fehlgeschlagen (dein Key ist kein Empfänger dieses Secrets)"
  "$PYTHON_BIN" - "$tmp" "$1" << 'EOF'
import json, sys
with open(sys.argv[1]) as f: data = json.load(f)
print(data.get(sys.argv[2], ""))
EOF
  rm -f "$tmp"
}

cmd_vault_list() {
  load_conf
  local d; d=$(vault_dir)
  [ -d "$d" ] || { info "Vault ist leer."; return; }
  local any=0
  for f in "$d"/*.yaml; do
    [ -f "$f" ] || continue
    any=1
    local name; name=$(basename "$f" .yaml)
    # Prüfen ob der eigene Key lesen kann (ohne Wert anzuzeigen)
    if SOPS_AGE_KEY_FILE="$AGE_KEY_FILE" sops -d --output-type json "$f" >/dev/null 2>&1; then
      echo "  🔓 $name (lesbar)"
    else
      echo "  🔒 $name (kein Zugriff)"
    fi
  done
  [ "$any" = "0" ] && info "Vault ist leer."
}

cmd_vault_add_key() {
  load_conf
  [ $# -ge 1 ] || die "Usage: agent-mesh vault add-key <agent-name>"
  local agent="$1" pub
  pub=$(age-keygen -y "$AGENT_MESH_HOME/keys/$agent.age" 2>/dev/null) \
    || die "Key für '$agent' nicht gefunden: $AGENT_MESH_HOME/keys/$agent.age"
  # Public-Key in die Registry legen (damit andere ihn als Empfänger nutzen können)
  mkdir -p "$MEMORIES_DIR/vault/keys"
  echo "$pub" > "$MEMORIES_DIR/vault/keys/$agent.age.pub"
  cd "$MEMORIES_DIR" && git add "vault/keys/$agent.age.pub" >/dev/null 2>&1
  git commit -m "vault: Public-Key für $agent registriert" >/dev/null 2>&1
  push_retry
  info "✅ Public-Key für '$agent' registriert — andere Agents können ihn via --for adressieren."
}

# ── Pins anzeigen / bewusst erneuern (Audit-Befund #6) ──
cmd_vault_pins() {
  load_conf
  local any=0
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    any=1
    local a="${line%%=*}"; a="${a#PIN_}"
    local k="${line#*=}"
    local cur=""
    [ -f "$MEMORIES_DIR/vault/keys/$a.age.pub" ] && cur=$(cat "$MEMORIES_DIR/vault/keys/$a.age.pub")
    if [ -z "$cur" ]; then
      echo "  ❔ $a — gepinnt, aber nicht mehr in der Registry"
    elif [ "$cur" = "$k" ]; then
      echo "  ✅ $a — ${k:0:24}…"
    else
      echo "  🚨 $a — ABWEICHUNG! gepinnt ${k:0:16}… · Registry ${cur:0:16}…"
    fi
  done < <(grep "^PIN_" "$CONF" 2>/dev/null || true)
  [ "$any" = "1" ] || info "Noch keine Keys gepinnt (passiert automatisch beim ersten send/vault set)."
}

cmd_vault_repin() {
  load_conf
  [ $# -ge 1 ] || die "Usage: agent-mesh vault repin <agent-name>"
  local a="$1"
  local f="$MEMORIES_DIR/vault/keys/$a.age.pub"
  [ -f "$f" ] || die "Kein Public-Key für '$a' in der Registry"
  local pub; pub=$(cat "$f")
  local old; old=$(pin_get "$a")
  echo "Agent:    $a"
  echo "Bisher:   ${old:-(kein Pin)}"
  echo "Neu:      $pub"
  echo ""
  echo "⚠️  Nur bestätigen, wenn du den neuen Key über einen ZWEITEN Kanal"
  echo "    (Anruf, Signal, SSH-Sitzung) mit '$a' abgeglichen hast."
  read -r -p "👉 Neuen Key übernehmen? (uebernehmen) " a2
  [ "$a2" = "uebernehmen" ] || die "Abgebrochen — Pin unverändert."
  pin_set "$a" "$pub"
  info "✅ Pin für '$a' erneuert."
}

# ── Security v1.1: Key-Revocation ──
# Entfernt einen Agent aus der Vault-Registry UND verschlüsselt ALLE Secrets
# neu OHNE dessen Key. Danach kann der entfernte Agent nichts mehr lesen.
cmd_vault_revoke() {
  load_conf
  [ $# -ge 1 ] || die "Usage: agent-mesh vault revoke <agent-name>"
  local agent="$1"
  local pub_file="$MEMORIES_DIR/vault/keys/$agent.age.pub"
  [ -f "$pub_file" ] || die "Kein Public-Key für '$agent' registriert"

  # Security v1.1 HÄRTUNG: Der Hub (Rolle=hub) darf NICHT still revoken —
  # doppelte Bestätigung + Warnung, wer da gerade entfernt wird!
  local myrole
  myrole=$(get_card | "$PYTHON_BIN" -c "import json,sys; print(json.load(sys.stdin).get('role','worker'))" 2>/dev/null || echo "worker")
  if [ "$agent" = "$AGENT_NAME" ]; then
    die "❌ Du kannst dich nicht selbst widerrufen! (Rolle: $myrole)"
  fi

  # Sicherheitsabfrage (destruktiv!) — ZWEI Bestätigungen nötig
  echo "⚠️  Agent '$agent' wird aus dem Vault entfernt:"
  echo "    - Public-Key gelöscht (vault/keys/$agent.age.pub)"
  echo "    - ALLE Secrets neu verschlüsselt OHNE $agent"
  echo "    - $agent kann danach KEINE Secrets mehr lesen"
  read -r -p "👉 Wirklich fortfahren? (ja/nein) " answer
  case "$(lower_of "$answer")" in
    j|ja|y|yes) ;;
    *) die "Abgebrochen." ;;
  esac
  read -r -p "👉 ENDGÜLTIG? Agent '$agent' unwiderruflich entfernen? (entfernen) " answer2
  [ "$(lower_of "$answer2")" = "entfernen" ] || die "Abgebrochen (Bestätigung war nicht 'entfernen')."

  # 1. Alle Secrets entschlüsseln (eigener Key muss Empfänger sein)
  local d; d=$(vault_dir)
  local tmpdir; tmpdir=$(mktemp -d)
  local count=0
  for f in "$d"/*.yaml; do
    [ -f "$f" ] || continue
    local name; name=$(basename "$f" .yaml)
    if ! SOPS_AGE_KEY_FILE="$AGE_KEY_FILE" sops -d --output-type json "$f" > "$tmpdir/$name.json" 2>/dev/null; then
      warn "  ⚠️  Secret '$name': nicht entschlüsselbar mit eigenem Key — übersprungen (bleibt wie es ist)"
      continue
    fi
    count=$((count+1))
  done
  [ "$count" -gt 0 ] || info "Keine entschlüsselbaren Secrets gefunden."

  # 2. Public-Key des zu entfernenden Agents merken, DANN löschen
  local revoked_pub; revoked_pub=$(cat "$pub_file")
  rm -f "$pub_file"
  rm -f "$MEMORIES_DIR/vault/keys/$agent.ssh.pub"
  pin_forget "$agent"
  pin_forget "SSH_$agent"

  # 3. Jedes Secret mit SEINER EIGENEN Empfängerliste neu verschlüsseln,
  #    abzüglich des widerrufenen Keys (Audit-Befund #5).
  #    Früher wurden hier ALLE registrierten Keys eingesetzt — das machte aus
  #    jedem selektiv geteilten Secret einen Broadcast ans ganze Mesh.
  local reenc=0 skipped=0
  for json in "$tmpdir"/*.json; do
    [ -f "$json" ] || continue
    local name; name=$(basename "$json" .json)
    local orig="$d/$name.yaml"

    # Ursprüngliche Empfänger dieses Secrets, ohne den widerrufenen Key
    local keys=() r
    while IFS= read -r r; do
      [ -n "$r" ] || continue
      [ "$r" = "$revoked_pub" ] && continue
      keys+=("$r")
    done < <(secret_recipients "$orig")

    if [ ${#keys[@]} -eq 0 ]; then
      warn "  ⚠️  '$name': nach dem Widerruf bliebe KEIN Empfänger übrig — unverändert gelassen."
      warn "      → Secret bewusst neu setzen: agent-mesh vault set $name <wert> --for <agents>"
      skipped=$((skipped+1))
      continue
    fi

    local recipients; recipients=$(printf '%s,' "${keys[@]}" | sed 's/,$//')
    SOPS_AGE_KEY_FILE="$AGE_KEY_FILE" sops --encrypt \
      --age "$recipients" --input-type json --output-type yaml \
      "$json" > "$orig" 2>/dev/null || die "Re-Encrypt von '$name' fehlgeschlagen"
    info "  ✓ $name neu verschlüsselt (${#keys[@]} Empfänger, ohne $agent)"
    reenc=$((reenc+1))
  done
  info "  → $reenc Secret(s) neu verschlüsselt, $skipped unverändert."
  rm -rf "$tmpdir"

  cd "$MEMORIES_DIR" && git add "vault/keys/" "vault/secrets/" >/dev/null 2>&1
  git commit -m "vault: REVOKE $agent — Keys entfernt, alle Secrets re-encrypted" >/dev/null 2>&1
  push_retry
  info "✅ Agent '$agent' widerrufen — kann keine Secrets mehr lesen."
}

# ── Nachrichten-Signatur (Security v1.15, Audit-Befund 10) ──
# age verschluesselt an einen OEFFENTLICHEN Key. Wer den kennt — und im
# privaten Repo kennt ihn jeder Leser —, kann eine Nachricht ERZEUGEN, die
# als "from": "ax41" in einer Mailbox landet. Der Auto-Responder reagiert
# automatisch darauf, Governance verteilt Auftraege ueber denselben Kanal.
# Verschluesselung ist Vertraulichkeit, nicht Echtheit.
#
# Deshalb bekommt jeder Agent zusaetzlich einen ed25519-SSH-Signaturschluessel.
# Signiert wird der KLARTEXT vor dem Verschluesseln (sign-then-encrypt), die
# Signatur reist im verschluesselten Umschlag mit — der Relay sieht sie nie.
SIGN_NS="agent-mesh-msg"

sign_key_file() { echo "$AGENT_MESH_HOME/keys/$AGENT_NAME.ssh"; }

# Signaturschluessel anlegen, falls er fehlt (auch fuer Bestands-Agents)
ensure_sign_key() {
  local f; f=$(sign_key_file)
  [ -f "$f" ] && return 0
  command -v ssh-keygen >/dev/null 2>&1 || die "ssh-keygen fehlt — ohne es koennen Nachrichten nicht signiert werden"
  mkdir -p "$(dirname "$f")"
  ssh-keygen -q -t ed25519 -f "$f" -N "" -C "$AGENT_NAME" </dev/null >/dev/null 2>&1 \
    || die "Signaturschluessel konnte nicht erzeugt werden ($f)"
  chmod 600 "$f" 2>/dev/null || true
  echo "🔑 Signaturschluessel fuer '$AGENT_NAME' erzeugt: $f" >&2
}

# Signatur-Public-Key eines Agents aus der Registry — gegen den Pin geprueft.
# ACHTUNG: stdout ist der Key, Meldungen nach stderr.
agent_sign_pub() {
  local a="$1"
  local f="$MEMORIES_DIR/vault/keys/$a.ssh.pub"
  [ -f "$f" ] || return 1
  local pub; pub=$(cat "$f")
  [ -n "$pub" ] || return 1
  local pinned; pinned=$(pin_get "SSH_$a")
  if [ -z "$pinned" ]; then
    pin_set "SSH_$a" "$pub"
    echo "🔑 Signatur-Key von '$a' erstmalig gepinnt (TOFU)" >&2
  elif [ "$pinned" != "$pub" ]; then
    echo "🚨 SIGNATUR-KEY-WECHSEL bei '$a' — Nachricht wird NICHT als echt anerkannt." >&2
    echo "   Uebernehmen nur nach Ruecksprache: agent-mesh vault repin $a" >&2
    return 1
  fi
  echo "$pub"
}

# Klartext-Payload signieren -> gibt die Signatur (armored) auf stdout
sign_payload() {
  # $1 = Datei mit dem zu signierenden Inhalt
  ensure_sign_key
  local f; f=$(sign_key_file)
  rm -f "$1.sig"
  ssh-keygen -Y sign -f "$f" -n "$SIGN_NS" "$1" >/dev/null 2>&1 || return 1
  cat "$1.sig"; rm -f "$1.sig"
}

# Signatur pruefen. 0 = echt und vom angegebenen Absender.
verify_payload() {
  # $1 = Datei mit dem Inhalt, $2 = Datei mit der Signatur, $3 = Absender
  local content="$1" sigfile="$2" from="$3"
  local pub; pub=$(agent_sign_pub "$from") || return 1
  local allow; allow=$(mktemp)
  printf '%s %s\n' "$from" "$pub" > "$allow"
  ssh-keygen -Y verify -f "$allow" -I "$from" -n "$SIGN_NS" -s "$sigfile" < "$content" >/dev/null 2>&1
  local rc=$?
  rm -f "$allow"
  return $rc
}

# ─────────────────────────── insight ───────────────────────────
cmd_insight() {
  load_conf
  [ $# -ge 2 ] || die "Usage: agent-mesh insight add <text>"
  local text="$*"
  local stamp; stamp=$(date -u +%Y%m%d-%H%M%S)
  local f="$MEMORIES_DIR/agents/$AGENT_NAME/insights/$stamp.md"
  mkdir -p "$(dirname "$f")"
  cat > "$f" << EOF
# Insight $stamp
**Agent:** $AGENT_NAME
**Datum:** $(date -u +%Y-%m-%dT%H:%M:%SZ)

$text
EOF
  cd "$MEMORIES_DIR" && git add "$f" && git commit -m "insight: $AGENT_NAME $stamp" >/dev/null 2>&1
  push_retry
  info "✅ Insight geteilt: agents/$AGENT_NAME/insights/$stamp.md"
}

# ─────────────────────────── status ───────────────────────────
cmd_status() {
  load_conf
  info "Agent: $AGENT_NAME"
  info "Key:   $AGE_PUB"
  if [ -d "$MEMORIES_DIR" ]; then
    info "Repo:  $MEMORIES_DIR ($(git -C "$MEMORIES_DIR" rev-parse --short HEAD 2>/dev/null || echo leer))"
    info "Agents im Mesh:"
    for d in "$MEMORIES_DIR"/agents/*/; do
      [ -d "$d" ] && echo "  • $(basename "$d")"
    done
    if [ -f "$MEMORIES_DIR/vault/secrets.yaml" ]; then
      info "Vault: vorhanden ($(sops --input-type yaml --output-type json -d "$MEMORIES_DIR/vault/secrets.yaml" 2>/dev/null | "$PYTHON_BIN" -c "import json,sys; print(len(json.load(sys.stdin)), 'Secrets')" 2>/dev/null || echo '?'))"
    fi
  fi
}

# ─────────────────────────── main ───────────────────────────
main() {
# ── Selbstauskunft, bevor irgendetwas Konfiguration braucht ──
# Hilfe und Version müssen auf einer frisch aufgesetzten Maschine funktionieren
# — dort, wo noch keine agent-mesh.conf existiert und man am ehesten nachsieht,
# wie das Werkzeug heisst.
case "${1:-}" in
  -h|--help|help)
    if [ -n "${2:-}" ]; then cli_cmd_help "$2"; exit $?; fi
    cli_overview; exit 0 ;;
  -V|--version|version)
    cli_version; exit 0 ;;
esac

# `agent-mesh <kommando> --help` — aber nur, wenn --help direkt hinter dem
# Kommando steht. Sonst würde "send ax41 'wie geht --help'" die Nachricht
# verschlucken, statt sie zu senden.
if [ -n "${1:-}" ] && cli_is_command "$1"; then
  case "${2:-}" in
    -h|--help) cli_cmd_help "$1"; exit 0 ;;
  esac
fi

case "${1:-}" in
  init)    shift; cmd_init "$@" ;;
  sync)    shift; cmd_sync ;;
  send)    shift; cmd_send "$@" ;;
  broadcast) shift; cmd_broadcast "$@" ;;
  peer-recv) shift; peer_recv ;;
  reply)   shift; cmd_reply "$@" ;;
  inbox)   shift; cmd_inbox ;;
  route)   shift; cmd_route "$@" ;;
  role)    shift; cmd_role "$@" ;;
  agents)  shift; cmd_agents ;;
  vault)   shift
           local sub="${1:-}"
           shift 2>/dev/null || true
           case "$sub" in
             set) cmd_vault_set "$@" ;;
             get) cmd_vault_get "$@" ;;
             list) cmd_vault_list ;;
             add-key) cmd_vault_add_key "$@" ;;
             revoke) cmd_vault_revoke "$@" ;;
             pins) cmd_vault_pins ;;
             repin) cmd_vault_repin "$@" ;;
             *) die "vault: {set|get|list|add-key|revoke|pins|repin}" ;;
           esac ;;
  insight) shift; cmd_insight "$@" ;;
  watch)   shift; cmd_watch "$@" ;;
  connect) shift; cmd_connect "$@" ;;
  doctor)  shift; cmd_doctor "$@" ;;
  report)  shift; cmd_report "$@" ;;
  fleet)   shift; cmd_fleet "$@" ;;
  maintenance) shift; cmd_maintenance "$@" ;;
  maintenance-run) shift; cmd_maintenance_run ;;
  respond) shift; cmd_respond "$@" ;;
  service) shift; cmd_service "$@" ;;
  govern)  shift; cmd_govern "$@" ;;
  autofix) shift; cmd_autofix "$@" ;;
  update)  shift; cmd_update "$@" ;;
  trust)   shift; cmd_trust "$@" ;;
  status)  shift; cmd_status ;;
  converge) shift; cmd_converge "$@" ;;
  memory)  shift; cmd_memory "$@" ;;
  # Ohne Argument: die Übersicht, nicht eine Zeile Usage. Der Exit-Code bleibt
  # 1 — ein Aufruf ohne Kommando hat nichts getan, und Skripte, die das bisher
  # geprüft haben, sollen weiter funktionieren.
  "") cli_overview >&2; exit 1 ;;
  *) cli_unknown "$1"; exit 2 ;;
esac
}
# Nur ausführen, wenn dieses Skript AUFGERUFEN wurde — nicht, wenn es gesourct
# wird. Erst dadurch kann eine Testsuite einzelne Funktionen prüfen, ohne dass
# der Dispatcher losläuft. (Die Module tun das seit jeher; das Hauptskript war
# die letzte Datei, die man nur als Ganzes starten konnte.)
if [ "${BASH_SOURCE[0]}" = "$0" ]; then
  main "$@"
fi
