[Unit]
Description=Agent-Mesh Webhook (Echtzeit-Trigger bei GitHub-Push)
After=network.target

[Service]
Type=simple
# Secret aus mesh.conf lesen (nie hart kodieren)
EnvironmentFile=/root/.hermes-mesh/mesh.conf
Environment=MESH_BIN=/usr/local/bin/mesh
Environment=MESH_WEBHOOK_PORT=8765
Environment=HOME=/root
ExecStart=/usr/bin/python3 /opt/agent-mesh-framework/mesh-webhook.py
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
