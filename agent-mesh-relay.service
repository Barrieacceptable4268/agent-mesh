[Unit]
Description=Agent-Mesh Relay (WebSocket — Echtzeit-Nachrichten zwischen Agents)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=-/etc/agent-mesh/relay.env
# Hermes-venv-Python nutzen (dort ist websockets installiert)
Environment=PATH=/usr/local/lib/hermes-agent/venv/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/local/lib/hermes-agent/venv/bin/python3 /usr/local/bin/agent-mesh-relay.py --port 8766 --host 127.0.0.1 --keys-dir /root/.agent-mesh/memories/vault/keys --queue-dir /var/lib/agent-mesh-relay
Restart=always
RestartSec=5
# Audit-Befund #9: Bind-Adresse explizit. Fuer Tailscale-Erreichbarkeit
# --host auf die Tailscale-IP setzen (z.B. 100.84.254.40), NICHT 0.0.0.0.
User=root

[Install]
WantedBy=multi-user.target
